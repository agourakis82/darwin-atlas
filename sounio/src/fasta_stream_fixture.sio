//@ run-pass

// Darwin Atlas streaming FASTA executable specification.
//
// This deliberately does not use the current upstream genomics FASTA helper:
// that helper is Seq256-bound and maps N to the canonical code for A. DOSA
// preserves all DNA IUPAC symbols and rejects every other sequence byte.
//
// The native runtime currently exposes argc/argv through arg_count/get_arg and
// POSIX I/O through syscall6. A 17-byte buffer forces parser state to cross
// chunk boundaries in the fixture.

const FASTA_CHUNK_BYTES: i64 = 17
const FASTA_HASH_MODULUS: i64 = 1000000007
const WINDOW_MAX_BYTES: i64 = 16
const KMER_ABS_MAX_K: i64 = 8
const KMER_TABLE_SIZE: i64 = 65536
const HEADER_ID_BYTES: i64 = 256
const METADATA_SPAN_MAX: i64 = 8192

fn fasta_ok() -> i64 { 0 }
fn fasta_err_open_failed() -> i64 { 1 }
fn fasta_err_read_failed() -> i64 { 2 }
fn fasta_err_sequence_before_header() -> i64 { 3 }
fn fasta_err_empty_header() -> i64 { 4 }
fn fasta_err_empty_sequence() -> i64 { 5 }
fn fasta_err_invalid_symbol() -> i64 { 6 }
fn fasta_err_no_records() -> i64 { 7 }
fn fasta_err_header_token_too_long() -> i64 { 8 }
fn fasta_err_metadata_invalid() -> i64 { 9 }
fn fasta_err_metadata_mismatch() -> i64 { 10 }
fn fasta_err_param_invalid() -> i64 { 11 }

var FASTA_BUF: [i8; 17] = [0; 17]
var SYMBOL_COUNTS: [i64; 15] = [0; 15]
var HEADER_ID_BUF: [i8; 256] = [0; 256]
var WINDOW_BASES: [i64; 16] = [0; 16]
var KMER_COUNTS: [i64; 65536] = [0; 65536]
var OBSERVED_CODES: [i64; 64] = [0; 64]

var G_ERROR_CODE: i64 = 0
var G_ERROR_OFFSET: i64 = 0
var G_ERROR_BYTE: i64 = 0
var G_BYTES_READ: i64 = 0
var G_CHUNKS_READ: i64 = 0
var G_RECORD_INDEX: i64 = 0
var G_HEADER_NONSPACE: i64 = 0
var G_SEQUENCE_LENGTH: i64 = 0
var G_CANONICAL_COUNT: i64 = 0
var G_AMBIGUOUS_COUNT: i64 = 0
var G_SEQUENCE_HASH: i64 = 0
var G_HEADER_ID_LEN: i64 = 0
var G_WINDOW_LEN: i64 = 0
var G_WINDOW_START: i64 = 0
var G_RECORD_WINDOW_INDEX: i64 = 0
var G_WINDOWS_EMITTED: i64 = 0
var G_METADATA_COUNT: i64 = 0
var G_WINDOW_SIZE: i64 = 0
var G_STRIDE: i64 = 0
var G_K_MAX: i64 = 0
var G_KMER_MIN_EFFECTIVE: i64 = 0
var G_OBSERVED_COUNT: i64 = 0
var G_HAVE_HEADER: bool = false
var G_IN_HEADER: bool = false
var G_AT_LINE_START: bool = true
var G_HEADER_TOKEN_DONE: bool = false
var G_PIPELINE_MODE: bool = false
var G_SIMPLE_KERNEL: bool = false
var G_REPLICON_PROFILE_MODE: bool = false
var G_EXCLUSIONS_MODE: bool = false
var G_INPUT_SHA: string = ""
var G_METADATA_TEXT: string = ""
var G_META_SEQUENCE: string = ""
var G_META_ASSEMBLY: string = ""
var G_META_CLASS: string = ""
var G_META_TOPOLOGY: string = ""
var G_META_SOURCE_SCOPE: string = ""
var G_PARAMETERS_SHA: string = ""

struct MetadataRow {
    found: bool,
    sequence_accession_version: string,
    assembly_accession_version: string,
    replicon_class: string,
    declared_topology: string,
    source_scope: string,
}

struct KmerMetric {
    effective_count: i64,
    numerator: i64,
    denominator: i64,
    available: bool,
}

fn iupac_index(ch: i64) -> i64 {
    if ch == 65 || ch == 97 { return 0 }   // A
    if ch == 67 || ch == 99 { return 1 }   // C
    if ch == 71 || ch == 103 { return 2 }  // G
    if ch == 84 || ch == 116 { return 3 }  // T
    if ch == 82 || ch == 114 { return 4 }  // R
    if ch == 89 || ch == 121 { return 5 }  // Y
    if ch == 83 || ch == 115 { return 6 }  // S
    if ch == 87 || ch == 119 { return 7 }  // W
    if ch == 75 || ch == 107 { return 8 }  // K
    if ch == 77 || ch == 109 { return 9 }  // M
    if ch == 66 || ch == 98 { return 10 }  // B
    if ch == 68 || ch == 100 { return 11 } // D
    if ch == 72 || ch == 104 { return 12 } // H
    if ch == 86 || ch == 118 { return 13 } // V
    if ch == 78 || ch == 110 { return 14 } // N
    -1
}

fn fasta_error_name(code: i64) -> string {
    if code == fasta_err_open_failed() { return "OPEN_FAILED" }
    if code == fasta_err_read_failed() { return "READ_FAILED" }
    if code == fasta_err_sequence_before_header() { return "SEQUENCE_BEFORE_HEADER" }
    if code == fasta_err_empty_header() { return "EMPTY_HEADER" }
    if code == fasta_err_empty_sequence() { return "EMPTY_SEQUENCE" }
    if code == fasta_err_invalid_symbol() { return "INVALID_SYMBOL" }
    if code == fasta_err_no_records() { return "NO_RECORDS" }
    if code == fasta_err_header_token_too_long() { return "HEADER_TOKEN_TOO_LONG" }
    if code == fasta_err_metadata_invalid() { return "METADATA_INVALID" }
    if code == fasta_err_metadata_mismatch() { return "METADATA_MISMATCH" }
    if code == fasta_err_param_invalid() { return "PARAM_INVALID" }
    "OK"
}

fn reset_record() with Mut, Panic {
    var i: i64 = 0
    while i < 15 {
        SYMBOL_COUNTS[i as usize] = 0
        i = i + 1
    }
    G_HEADER_NONSPACE = 0
    G_SEQUENCE_LENGTH = 0
    G_CANONICAL_COUNT = 0
    G_AMBIGUOUS_COUNT = 0
    G_SEQUENCE_HASH = 0
    G_HEADER_ID_LEN = 0
    G_HEADER_TOKEN_DONE = false
    G_WINDOW_LEN = 0
    G_WINDOW_START = 0
    G_RECORD_WINDOW_INDEX = 0
    G_META_SEQUENCE = ""
    G_META_ASSEMBLY = ""
    G_META_CLASS = ""
    G_META_TOPOLOGY = ""
    G_META_SOURCE_SCOPE = ""
}

fn set_error(code: i64, offset: i64, byte: i64) with Mut {
    if G_ERROR_CODE == fasta_ok() {
        G_ERROR_CODE = code
        G_ERROR_OFFSET = offset
        G_ERROR_BYTE = byte
    }
}

fn parse_decimal_digit(ch: i64) -> i64 {
    if ch >= 48 && ch <= 57 { ch - 48 } else { -1 }
}

// The native x86-64 backend implements str_slice(s, start, end) as a suffix
// operation that ignores its third argument (upstream codegen_x86_linux.sio:
// "str_slice(s: *u8, start: i64) -> *u8"), and str_from_bytes only resolves
// local array handles, not globals. Bounded spans are therefore built by
// copying bytes into a local scratch buffer and re-materializing them with
// str_from_bytes. An out-of-contract span returns the empty string, which the
// metadata validators reject as METADATA_INVALID; nothing is silently
// truncated.
fn str_span(text: string, start: i64, end: i64) -> string with Mut, Panic, Div {
    if start < 0 || end < start { return "" }
    let n = end - start
    if n <= 0 { return "" }
    if n > METADATA_SPAN_MAX { return "" }
    var buf: [i8; 8192] = [0; 8192]
    var i: i64 = 0
    while i < n {
        buf[i as usize] = str_char_at(text, start + i) as i8
        i = i + 1
    }
    str_from_bytes(buf, n)
}

fn parse_nonnegative_i64(raw: string) -> i64 with Mut, Panic, Div {
    let n = str_len(raw)
    if n <= 0 { return -1 }

    var value: i64 = 0
    var i: i64 = 0
    while i < n {
        let digit = parse_decimal_digit(str_char_at(raw, i))
        if digit < 0 { return -1 }
        value = value * 10 + digit
        i = i + 1
    }
    value
}

fn tsv_field_count(line: string) -> i64 with Mut, Panic, Div {
    var count: i64 = 1
    var i: i64 = 0
    let n = str_len(line)
    while i < n {
        if str_char_at(line, i) == 9 { count = count + 1 }
        i = i + 1
    }
    count
}

fn tsv_get_field(line: string, target: i64) -> string with Mut, Panic, Div {
    if target < 0 { return "" }

    let n = str_len(line)
    var field: i64 = 0
    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(line, i) == 9 {
            if field == target { return str_span(line, start, i) }
            field = field + 1
            start = i + 1
        }
        i = i + 1
    }
    if field == target { str_span(line, start, n) } else { "" }
}

fn metadata_value_is_json_safe(value: string) -> bool with Mut, Panic, Div {
    let n = str_len(value)
    if n <= 0 { return false }

    var i: i64 = 0
    while i < n {
        let ch = str_char_at(value, i)
        let upper = ch >= 65 && ch <= 90
        let lower = ch >= 97 && ch <= 122
        let digit = ch >= 48 && ch <= 57
        if !upper && !lower && !digit && ch != 46 && ch != 95 && ch != 45 {
            return false
        }
        i = i + 1
    }
    true
}

fn metadata_line_is_header(line: string) -> bool with Mut, Panic, Div {
    tsv_field_count(line) == 6
        && str_eq(tsv_get_field(line, 0), "record_index")
        && str_eq(tsv_get_field(line, 1), "sequence_accession_version")
        && str_eq(tsv_get_field(line, 2), "assembly_accession_version")
        && str_eq(tsv_get_field(line, 3), "replicon_class")
        && str_eq(tsv_get_field(line, 4), "declared_topology")
        && str_eq(tsv_get_field(line, 5), "source_scope")
}

fn metadata_data_line_is_valid(line: string, expected_index: i64) -> bool with Mut, Panic, Div {
    if tsv_field_count(line) != 6 { return false }
    if parse_nonnegative_i64(tsv_get_field(line, 0)) != expected_index { return false }

    let sequence = tsv_get_field(line, 1)
    let assembly = tsv_get_field(line, 2)
    let replicon_class = tsv_get_field(line, 3)
    let topology = tsv_get_field(line, 4)
    let source_scope = tsv_get_field(line, 5)

    if !metadata_value_is_json_safe(sequence) { return false }
    if !metadata_value_is_json_safe(assembly) { return false }
    if !metadata_value_is_json_safe(replicon_class) { return false }
    if !metadata_value_is_json_safe(topology) { return false }
    if !metadata_value_is_json_safe(source_scope) { return false }
    if !str_eq(topology, "circular") && !str_eq(topology, "linear") && !str_eq(topology, "unknown") {
        return false
    }
    true
}

fn load_metadata(path: string) -> bool with IO, Mut, Panic, Div {
    let text = read_file(path)
    let n = str_len(text)
    if n <= 0 {
        set_error(fasta_err_metadata_invalid(), 0, -1)
        return false
    }

    var start: i64 = 0
    var logical_line: i64 = 0
    var data_count: i64 = 0
    while start <= n {
        var end = start
        while end < n && str_char_at(text, end) != 10 {
            end = end + 1
        }

        var line_end = end
        if line_end > start && str_char_at(text, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        let line = str_span(text, start, line_end)

        if str_len(line) > 0 {
            if logical_line == 0 {
                if !metadata_line_is_header(line) {
                    set_error(fasta_err_metadata_invalid(), start, -1)
                    return false
                }
            } else {
                let expected_index = data_count + 1
                if !metadata_data_line_is_valid(line, expected_index) {
                    set_error(fasta_err_metadata_invalid(), start, -1)
                    return false
                }
                data_count = data_count + 1
            }
            logical_line = logical_line + 1
        }

        if end >= n { break }
        start = end + 1
    }

    if logical_line <= 1 || data_count <= 0 {
        set_error(fasta_err_metadata_invalid(), n, -1)
        return false
    }

    G_METADATA_TEXT = text
    G_METADATA_COUNT = data_count
    true
}

fn empty_metadata_row() -> MetadataRow {
    MetadataRow {
        found: false,
        sequence_accession_version: "",
        assembly_accession_version: "",
        replicon_class: "",
        declared_topology: "",
        source_scope: "",
    }
}

fn metadata_row_at(target_index: i64) -> MetadataRow with Mut, Panic, Div {
    let n = str_len(G_METADATA_TEXT)
    var start: i64 = 0
    var logical_line: i64 = 0
    var data_index: i64 = 0
    while start <= n {
        var end = start
        while end < n && str_char_at(G_METADATA_TEXT, end) != 10 {
            end = end + 1
        }

        var line_end = end
        if line_end > start && str_char_at(G_METADATA_TEXT, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        let line = str_span(G_METADATA_TEXT, start, line_end)

        if str_len(line) > 0 {
            if logical_line > 0 {
                data_index = data_index + 1
                if data_index == target_index {
                    return MetadataRow {
                        found: true,
                        sequence_accession_version: tsv_get_field(line, 1),
                        assembly_accession_version: tsv_get_field(line, 2),
                        replicon_class: tsv_get_field(line, 3),
                        declared_topology: tsv_get_field(line, 4),
                        source_scope: tsv_get_field(line, 5),
                    }
                }
            }
            logical_line = logical_line + 1
        }

        if end >= n { break }
        start = end + 1
    }
    empty_metadata_row()
}

// ---------------------------------------------------------------------------
// Pipeline parameters (strict flat rendering of the canonical JSON artifact)
//
// The canonical parameter artifact is JSON validated and hashed by the runner.
// A full JSON parser inside the executable would be an unnecessarily wide and
// permissive surface, so the runner renders a fixed-order key=value file and
// this parser accepts exactly that rendering: 13 lines, exact keys in exact
// order, fixed value vocabularies, no extras. Any deviation is PARAM_INVALID
// with the zero-based byte offset of the offending line.
// ---------------------------------------------------------------------------

fn flat_param_value(text: string, start: i64, end: i64, expected_key: string) -> string with Mut, Panic, Div {
    let key_len = str_len(expected_key)
    if end - start <= key_len { return "" }
    var i: i64 = 0
    while i < key_len {
        if str_char_at(text, start + i) != str_char_at(expected_key, i) { return "" }
        i = i + 1
    }
    if str_char_at(text, start + key_len) != 61 { return "" } // '='
    str_span(text, start + key_len + 1, end)
}

fn is_hex_sha256(value: string) -> bool with Mut, Panic, Div {
    if str_len(value) != 64 { return false }
    var i: i64 = 0
    while i < 64 {
        let ch = str_char_at(value, i)
        let digit = ch >= 48 && ch <= 57
        let lower = ch >= 97 && ch <= 102
        if !digit && !lower { return false }
        i = i + 1
    }
    true
}

fn validate_param_line(text: string, start: i64, end: i64, line_index: i64) -> bool with Mut, Panic, Div {
    if line_index == 0 { return str_eq(flat_param_value(text, start, end, "schema_version"), "1.0.0") }
    if line_index == 1 { return str_eq(flat_param_value(text, start, end, "specification_version"), "0.1.0") }
    if line_index == 2 {
        let value = parse_nonnegative_i64(flat_param_value(text, start, end, "window_size"))
        if value < 1 || value > WINDOW_MAX_BYTES { return false }
        G_WINDOW_SIZE = value
        return true
    }
    if line_index == 3 {
        let value = parse_nonnegative_i64(flat_param_value(text, start, end, "stride"))
        if value <= 0 || value != G_WINDOW_SIZE { return false }
        G_STRIDE = value
        return true
    }
    if line_index == 4 { return parse_nonnegative_i64(flat_param_value(text, start, end, "k_min")) == 1 }
    if line_index == 5 {
        let value = parse_nonnegative_i64(flat_param_value(text, start, end, "k_max"))
        if value < 1 || value > KMER_ABS_MAX_K || value > G_WINDOW_SIZE { return false }
        G_K_MAX = value
        return true
    }
    if line_index == 6 {
        let value = parse_nonnegative_i64(flat_param_value(text, start, end, "min_kmer_effective_count"))
        if value < 1 { return false }
        G_KMER_MIN_EFFECTIVE = value
        return true
    }
    if line_index == 7 { return str_eq(flat_param_value(text, start, end, "positional_ambiguity_policy"), "canonical_only") }
    if line_index == 8 { return str_eq(flat_param_value(text, start, end, "kmer_ambiguity_policy"), "masked") }
    if line_index == 9 { return str_eq(flat_param_value(text, start, end, "coordinate_system"), "zero_based_half_open") }
    if line_index == 10 { return str_eq(flat_param_value(text, start, end, "window_wraparound"), "false") }
    if line_index == 11 { return str_eq(flat_param_value(text, start, end, "output_order"), "manifest_record_then_window_start") }
    if line_index == 12 {
        let value = flat_param_value(text, start, end, "parameters_sha256")
        if !is_hex_sha256(value) { return false }
        G_PARAMETERS_SHA = value
        return true
    }
    false
}

fn load_parameters(path: string) -> bool with IO, Mut, Panic, Div {
    let text = read_file(path)
    let n = str_len(text)
    if n <= 0 {
        set_error(fasta_err_param_invalid(), 0, -1)
        return false
    }

    var start: i64 = 0
    var line_index: i64 = 0
    while start <= n {
        var end = start
        while end < n && str_char_at(text, end) != 10 {
            end = end + 1
        }

        var line_end = end
        if line_end > start && str_char_at(text, line_end - 1) == 13 {
            line_end = line_end - 1
        }

        if line_end > start {
            if line_index >= 13 || !validate_param_line(text, start, line_end, line_index) {
                set_error(fasta_err_param_invalid(), start, -1)
                return false
            }
            line_index = line_index + 1
        }

        if end >= n { break }
        start = end + 1
    }

    if line_index != 13 {
        set_error(fasta_err_param_invalid(), n, -1)
        return false
    }
    true
}

fn header_id_equals(text: string) -> bool with Mut, Panic, Div {
    if str_len(text) != G_HEADER_ID_LEN { return false }
    var i: i64 = 0
    while i < G_HEADER_ID_LEN {
        if str_char_at(text, i) != HEADER_ID_BUF[i as usize] as i64 { return false }
        i = i + 1
    }
    true
}

fn validate_header_metadata(offset: i64) with Mut, Panic, Div {
    if !G_PIPELINE_MODE && !G_EXCLUSIONS_MODE && !G_REPLICON_PROFILE_MODE { return }
    if G_HEADER_ID_LEN <= 0 {
        set_error(fasta_err_empty_header(), offset, -1)
        return
    }

    let row = metadata_row_at(G_RECORD_INDEX)
    if !row.found {
        set_error(fasta_err_metadata_mismatch(), offset, -1)
        return
    }

    // str_from_bytes does not resolve global array handles in the native
    // backend, so the captured header token is compared byte by byte.
    if !header_id_equals(row.sequence_accession_version) {
        set_error(fasta_err_metadata_mismatch(), offset, -1)
        return
    }

    G_META_SEQUENCE = row.sequence_accession_version
    G_META_ASSEMBLY = row.assembly_accession_version
    G_META_CLASS = row.replicon_class
    G_META_TOPOLOGY = row.declared_topology
    G_META_SOURCE_SCOPE = row.source_scope
}

fn base_complement(base: i64) -> i64 {
    if base == 0 { return 3 }
    if base == 1 { return 2 }
    if base == 2 { return 1 }
    if base == 3 { return 0 }
    -1
}

fn pow4(k: i64) -> i64 {
    var value: i64 = 1
    var i: i64 = 0
    while i < k {
        value = value * 4
        i = i + 1
    }
    value
}

// Encode one canonical k-mer as a base-4 integer. Ambiguous symbols and spans
// outside the current window return -1 and are masked from composition counts.
fn kmer_code_at(start: i64, k: i64) -> i64 with Mut, Panic, Div {
    if k <= 0 || start < 0 || start + k > G_WINDOW_LEN { return -1 }
    var code: i64 = 0
    var i: i64 = 0
    while i < k {
        let base = WINDOW_BASES[(start + i) as usize]
        if base < 0 || base > 3 { return -1 }
        code = code * 4 + base
        i = i + 1
    }
    code
}

fn kmer_transform(code: i64, k: i64, complement: bool) -> i64 with Mut, Panic, Div {
    // Arithmetic digit reversal: consuming digits LSB-first and appending to
    // `out` yields the reversed (optionally complemented) k-mer with no local
    // array. A local [i64; k] buffer here would allocate from a compiler arena
    // that is never reclaimed inside loops, exhausting it after ~1M calls.
    var value = code
    var out: i64 = 0
    var i: i64 = 0
    while i < k {
        let base = value % 4
        value = value / 4
        let transformed = if complement { base_complement(base) } else { base }
        out = out * 4 + transformed
        i = i + 1
    }
    out
}

fn count_kmer_code(target: i64, k: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var start: i64 = 0
    while start + k <= G_WINDOW_LEN {
        if kmer_code_at(start, k) == target { count = count + 1 }
        start = start + 1
    }
    count
}

// Compute the orbit-paired imbalance numerator and denominator from masked
// canonical k-mers. Self-transformed k-mers contribute their count once to the
// denominator and zero to the numerator, exactly as specification 0.1.0 §7.2.
fn compute_kmer_metric(k: i64, complement: bool) -> KmerMetric with Mut, Panic, Div {
    var effective_count: i64 = 0
    var start: i64 = 0
    while start + k <= G_WINDOW_LEN {
        if kmer_code_at(start, k) >= 0 { effective_count = effective_count + 1 }
        start = start + 1
    }

    if effective_count < G_KMER_MIN_EFFECTIVE {
        return KmerMetric {
            effective_count: effective_count,
            numerator: 0,
            denominator: 0,
            available: false,
        }
    }

    var numerator: i64 = 0
    var denominator: i64 = 0
    var code: i64 = 0
    let limit = pow4(k)
    while code < limit {
        let partner = kmer_transform(code, k, complement)
        if code <= partner {
            let left = count_kmer_code(code, k)
            if code == partner {
                denominator = denominator + left
            } else {
                let right = count_kmer_code(partner, k)
                let difference = if left >= right { left - right } else { right - left }
                numerator = numerator + difference
                denominator = denominator + left + right
            }
        }
        code = code + 1
    }

    KmerMetric {
        effective_count: effective_count,
        numerator: numerator,
        denominator: denominator,
        available: denominator > 0,
    }
}

// ---------------------------------------------------------------------------
// Scale-oriented k-mer kernel.
//
// One fixed 4^8 i64 table (512 KiB), independent of replicon size, zeroed
// deterministically per window and k. Counting is a single rolling pass over
// the window: ambiguity resets the rolling code, so masked k-mers never span
// an ambiguous symbol. The counting pass also records each code at its first
// observation (at most WINDOW_LEN distinct codes per window, so a 64-slot
// global list cannot overflow at the current 16 bp maximum window). Orbits
// are evaluated over the observed codes only, never over the full 4^k space:
// each unordered orbit {u,T(u)} contributes exactly once — at the observed
// smaller member, at a self-transformed member, or at an observed larger
// member whose transform was never observed (the zero-representative case a
// naive observed-only scan would miss). The reference kernel above
// (compute_kmer_metric) must produce identical results on every fixture.
// ---------------------------------------------------------------------------

fn zero_kmer_table(k: i64) with Mut, Panic, Div {
    let limit = pow4(k)
    var i: i64 = 0
    while i < limit {
        KMER_COUNTS[i as usize] = 0
        i = i + 1
    }
}

fn count_kmers_rolling(k: i64) -> i64 with Mut, Panic, Div {
    var code: i64 = 0
    var run: i64 = 0
    var effective: i64 = 0
    let limit = pow4(k)
    var i: i64 = 0
    while i < G_WINDOW_LEN {
        let base = WINDOW_BASES[i as usize]
        if base >= 0 && base <= 3 {
            code = (code * 4 + base) % limit
            run = run + 1
            if run >= k {
                if KMER_COUNTS[code as usize] == 0 {
                    OBSERVED_CODES[G_OBSERVED_COUNT as usize] = code
                    G_OBSERVED_COUNT = G_OBSERVED_COUNT + 1
                }
                KMER_COUNTS[code as usize] = KMER_COUNTS[code as usize] + 1
                effective = effective + 1
            }
        } else {
            code = 0
            run = 0
        }
        i = i + 1
    }
    effective
}

fn compute_kmer_metric_optimized(k: i64, complement: bool) -> KmerMetric with Mut, Panic, Div {
    zero_kmer_table(k)
    G_OBSERVED_COUNT = 0
    let effective_count = count_kmers_rolling(k)
    if effective_count < G_KMER_MIN_EFFECTIVE {
        return KmerMetric {
            effective_count: effective_count,
            numerator: 0,
            denominator: 0,
            available: false,
        }
    }

    // Iterate the observed codes only. For each observed u with v = T(u):
    //   u < v  -> process the pair here (the full scan would process it at u);
    //   u == v -> self-transformed: denominator takes the count once;
    //   u > v  -> the orbit representative is v: skip when v was also observed
    //             (the pair is processed at v), but when v was never observed
    //             the full scan would still process the orbit at v with a zero
    //             representative, contributing |0 - count(u)| = count(u) to
    //             both numerator and denominator. Handle that case here.
    var numerator: i64 = 0
    var denominator: i64 = 0
    var obs: i64 = 0
    while obs < G_OBSERVED_COUNT {
        let code = OBSERVED_CODES[obs as usize]
        let partner = kmer_transform(code, k, complement)
        let left = KMER_COUNTS[code as usize]
        if code < partner {
            let right = KMER_COUNTS[partner as usize]
            let difference = if left >= right { left - right } else { right - left }
            numerator = numerator + difference
            denominator = denominator + left + right
        } else {
            if code == partner {
                denominator = denominator + left
            } else {
                if KMER_COUNTS[partner as usize] == 0 {
                    numerator = numerator + left
                    denominator = denominator + left
                }
            }
        }
        obs = obs + 1
    }

    KmerMetric {
        effective_count: effective_count,
        numerator: numerator,
        denominator: denominator,
        available: denominator > 0,
    }
}

fn window_is_canonical() -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < G_WINDOW_LEN {
        let base = WINDOW_BASES[i as usize]
        if base < 0 || base > 3 { return false }
        i = i + 1
    }
    true
}

fn print_ratio_6(numerator: i64, denominator: i64) with IO, Div {
    let scaled = (numerator * 1000000) / denominator
    print_int(scaled / 1000000)
    print(".")
    var divisor: i64 = 100000
    while divisor > 0 {
        print_int((scaled / divisor) % 10)
        divisor = divisor / 10
    }
}

fn print_json_bool(value: bool) with IO {
    if value { print("true") } else { print("false") }
}

fn print_kmer_null_triplets(k: i64) with IO {
    print(",\"reverse_kmer_imbalance_")
    print_int(k)
    print("_numerator\":null,\"reverse_kmer_imbalance_")
    print_int(k)
    print("_denominator\":null,\"reverse_kmer_imbalance_")
    print_int(k)
    print("\":null,\"rc_kmer_imbalance_")
    print_int(k)
    print("_numerator\":null,\"rc_kmer_imbalance_")
    print_int(k)
    print("_denominator\":null,\"rc_kmer_imbalance_")
    print_int(k)
    print("\":null")
}

fn print_kmer_metric_fields(k: i64) with IO, Mut, Panic, Div {
    print(",\"kmer_")
    print_int(k)
    print("_effective_count\":")
    if k > G_K_MAX {
        // Outside the configured range: nothing was computed, null everywhere,
        // never zero-filled.
        print("null")
        print(",\"kmer_")
        print_int(k)
        print("_unavailable_reason\":\"K_OUT_OF_CONFIGURED_RANGE\"")
        print_kmer_null_triplets(k)
        return
    }

    let reverse_metric = if G_SIMPLE_KERNEL { compute_kmer_metric(k, false) } else { compute_kmer_metric_optimized(k, false) }
    let rc_metric = if G_SIMPLE_KERNEL { compute_kmer_metric(k, true) } else { compute_kmer_metric_optimized(k, true) }

    print_int(reverse_metric.effective_count)
    print(",\"kmer_")
    print_int(k)
    print("_unavailable_reason\":")
    if !reverse_metric.available {
        print("\"INSUFFICIENT_EFFECTIVE_KMERS\"")
        print_kmer_null_triplets(k)
        return
    }
    print("null")

    print(",\"reverse_kmer_imbalance_")
    print_int(k)
    print("_numerator\":")
    print_int(reverse_metric.numerator)
    print(",\"reverse_kmer_imbalance_")
    print_int(k)
    print("_denominator\":")
    print_int(reverse_metric.denominator)
    print(",\"reverse_kmer_imbalance_")
    print_int(k)
    print("\":")
    print_ratio_6(reverse_metric.numerator, reverse_metric.denominator)

    print(",\"rc_kmer_imbalance_")
    print_int(k)
    print("_numerator\":")
    print_int(rc_metric.numerator)
    print(",\"rc_kmer_imbalance_")
    print_int(k)
    print("_denominator\":")
    print_int(rc_metric.denominator)
    print(",\"rc_kmer_imbalance_")
    print_int(k)
    print("\":")
    print_ratio_6(rc_metric.numerator, rc_metric.denominator)
}

// ---------------------------------------------------------------------------
// Product emitters (engineering-scope canonical products, spec 0.1.0 §11).
//
// --replicon-profile emits one atlas_replicons JSONL line per record from the
// same per-record counters the summary mode reports; gc_fraction is the
// six-decimal (C+G)/canonical ratio, null when the record has no canonical
// bases. --exclusions replays the window pass and emits one excluded_records
// JSONL line per excluded window (positional pair) and per unavailable k-mer
// imbalance field, mirroring the window-line reason codes exactly.
// ---------------------------------------------------------------------------

fn emit_exclusion_prefix(exclusion_level: string, window_start: i64, window_end: i64) with IO {
    // String literals are kept short: the native backend rotates literals of
    // ~110+ bytes (the final byte wraps to the front of the printed string).
    print("{\"schema_version\":\"0.1.0\",\"specification_version\":\"0.1.0\",")
    print("\"metric_version\":\"0.1.0\",\"exclusion_level\":\"")
    print(exclusion_level)
    print("\",\"sequence_accession_version\":\"")
    print(G_META_SEQUENCE)
    print("\",\"assembly_accession_version\":\"")
    print(G_META_ASSEMBLY)
    print("\",\"window_start\":")
    print_int(window_start)
    print(",\"window_end\":")
    print_int(window_end)
    print(",\"metric\":\"")
}

fn emit_exclusion_positional(reason: string, window_start: i64, window_end: i64) with IO {
    emit_exclusion_prefix("window", window_start, window_end)
    print("positional\",\"reason_code\":\"")
    print(reason)
    print("\"}\n")
}

fn emit_exclusion_kmer(k: i64, complement: bool, reason: string, window_start: i64, window_end: i64) with IO {
    emit_exclusion_prefix("metric", window_start, window_end)
    if complement { print("rc_kmer_imbalance_") } else { print("reverse_kmer_imbalance_") }
    print_int(k)
    print("\",\"reason_code\":\"")
    print(reason)
    print("\"}\n")
}

fn emit_replicon_profile() with IO, Mut, Panic, Div {
    let gc_count = SYMBOL_COUNTS[1] + SYMBOL_COUNTS[2]
    // String literals are kept short: the native backend rotates literals of
    // ~110+ bytes (the final byte wraps to the front of the printed string).
    print("{\"schema_version\":\"0.1.0\",\"specification_version\":\"0.1.0\",")
    print("\"metric_version\":\"0.1.0\",\"sequence_accession_version\":\"")
    print(G_META_SEQUENCE)
    print("\",\"assembly_accession_version\":\"")
    print(G_META_ASSEMBLY)
    print("\",\"replicon_class\":\"")
    print(G_META_CLASS)
    print("\",\"declared_topology\":\"")
    print(G_META_TOPOLOGY)
    print("\",\"length_bp\":")
    print_int(G_SEQUENCE_LENGTH)
    print(",\"canonical_count\":")
    print_int(G_CANONICAL_COUNT)
    print(",\"ambiguous_count\":")
    print_int(G_AMBIGUOUS_COUNT)
    print(",\"gc_fraction\":")
    if G_CANONICAL_COUNT > 0 { print_ratio_6(gc_count, G_CANONICAL_COUNT) } else { print("null") }
    print(",\"input_sha256\":\"")
    print(G_INPUT_SHA)
    print("\",\"included\":true,\"exclusion_reason\":null}\n")
}

// Effective masked k-mer count of the current window without the count
// table: canonical runs of length >= k each contribute one valid k-mer. In
// the window-line semantics availability is decided by
// effective_count >= min_kmer_effective_count: with min >= 1, effective >= min
// implies effective > 0, which forces at least one observed k-mer and hence a
// positive orbit denominator (available == true); conversely effective < min
// is exactly the INSUFFICIENT_EFFECTIVE_KMERS early return. The exclusions
// mode therefore derives availability from this count alone, keeping the
// per-replicon exclusions pass O(window) per k; the byte-exact Julia
// differential independently recomputes the same lines.
fn window_effective_kmer_count(k: i64) -> i64 with Mut, Panic, Div {
    var run: i64 = 0
    var effective: i64 = 0
    var i: i64 = 0
    while i < G_WINDOW_LEN {
        let base = WINDOW_BASES[i as usize]
        if base >= 0 && base <= 3 {
            run = run + 1
            if run >= k { effective = effective + 1 }
        } else {
            run = 0
        }
        i = i + 1
    }
    effective
}

fn emit_pipeline_window() with IO, Mut, Panic, Div {
    let partial = G_WINDOW_LEN < G_WINDOW_SIZE
    let canonical = window_is_canonical()
    let excluded = partial || !canonical
    let window_end = G_WINDOW_START + G_WINDOW_LEN

    if G_EXCLUSIONS_MODE {
        if partial {
            emit_exclusion_positional("PARTIAL_WINDOW", G_WINDOW_START, window_end)
        } else if !canonical {
            emit_exclusion_positional("AMBIGUOUS_WINDOW", G_WINDOW_START, window_end)
        }
        var k: i64 = 1
        while k <= KMER_ABS_MAX_K {
            if k > G_K_MAX {
                emit_exclusion_kmer(k, false, "K_OUT_OF_CONFIGURED_RANGE", G_WINDOW_START, window_end)
                emit_exclusion_kmer(k, true, "K_OUT_OF_CONFIGURED_RANGE", G_WINDOW_START, window_end)
            } else {
                let effective = window_effective_kmer_count(k)
                if effective < G_KMER_MIN_EFFECTIVE {
                    emit_exclusion_kmer(k, false, "INSUFFICIENT_EFFECTIVE_KMERS", G_WINDOW_START, window_end)
                    emit_exclusion_kmer(k, true, "INSUFFICIENT_EFFECTIVE_KMERS", G_WINDOW_START, window_end)
                }
            }
            k = k + 1
        }
        G_WINDOW_START = window_end
        G_WINDOW_LEN = 0
        G_RECORD_WINDOW_INDEX = G_RECORD_WINDOW_INDEX + 1
        G_WINDOWS_EMITTED = G_WINDOWS_EMITTED + 1
        return
    }

    var reverse_mismatches: i64 = 0
    var rc_mismatches: i64 = 0
    if !excluded {
        var i: i64 = 0
        while i < G_WINDOW_LEN {
            let opposite = WINDOW_BASES[(G_WINDOW_LEN - 1 - i) as usize]
            if WINDOW_BASES[i as usize] != opposite {
                reverse_mismatches = reverse_mismatches + 1
            }
            if WINDOW_BASES[i as usize] != base_complement(opposite) {
                rc_mismatches = rc_mismatches + 1
            }
            i = i + 1
        }
    }

    print("{\"schema_version\":\"0.2.0\",\"metric_version\":\"0.1.0\",\"parameters_sha256\":\"")
    print(G_PARAMETERS_SHA)
    print("\",\"assembly_accession_version\":\"")
    print(G_META_ASSEMBLY)
    print("\",\"sequence_accession_version\":\"")
    print(G_META_SEQUENCE)
    print("\",\"replicon_class\":\"")
    print(G_META_CLASS)
    print("\",\"declared_topology\":\"")
    print(G_META_TOPOLOGY)
    print("\",\"source_scope\":\"")
    print(G_META_SOURCE_SCOPE)
    print("\",\"record_index\":")
    print_int(G_RECORD_INDEX)
    print(",\"window_index\":")
    print_int(G_RECORD_WINDOW_INDEX)
    print(",\"window_start\":")
    print_int(G_WINDOW_START)
    print(",\"window_end\":")
    print_int(window_end)
    print(",\"window_length\":")
    print_int(G_WINDOW_LEN)
    print(",\"ambiguity_policy\":\"canonical_only\",\"status\":\"")
    if excluded { print("excluded") } else { print("ok") }
    print("\",\"reason_code\":")
    if partial {
        print("\"PARTIAL_WINDOW\"")
    } else if !canonical {
        print("\"AMBIGUOUS_WINDOW\"")
    } else {
        print("null")
    }
    print(",\"effective_count\":")
    if excluded { print_int(0) } else { print_int(G_WINDOW_LEN) }
    print(",\"delta_R_mismatches\":")
    if excluded { print("null") } else { print_int(reverse_mismatches) }
    print(",\"delta_RC_mismatches\":")
    if excluded { print("null") } else { print_int(rc_mismatches) }
    print(",\"denominator\":")
    if excluded { print("null") } else { print_int(G_WINDOW_LEN) }
    print(",\"delta_R\":")
    if excluded { print("null") } else { print_ratio_6(reverse_mismatches, G_WINDOW_LEN) }
    print(",\"delta_RC\":")
    if excluded { print("null") } else { print_ratio_6(rc_mismatches, G_WINDOW_LEN) }
    print(",\"fixed_R\":")
    if excluded { print("null") } else { print_json_bool(reverse_mismatches == 0) }
    print(",\"fixed_RC\":")
    if excluded { print("null") } else { print_json_bool(rc_mismatches == 0) }
    print(",\"kmer_ambiguity_policy\":\"masked\",\"kmer_min_effective_count\":")
    print_int(G_KMER_MIN_EFFECTIVE)
    var k: i64 = 1
    while k <= KMER_ABS_MAX_K {
        print_kmer_metric_fields(k)
        k = k + 1
    }
    print("}\n")

    G_WINDOW_START = window_end
    G_WINDOW_LEN = 0
    G_RECORD_WINDOW_INDEX = G_RECORD_WINDOW_INDEX + 1
    G_WINDOWS_EMITTED = G_WINDOWS_EMITTED + 1
}

fn print_record() with IO, Mut, Panic {
    print("DOSA_FASTA_RECORD index=")
    print_int(G_RECORD_INDEX)
    print(" length=")
    print_int(G_SEQUENCE_LENGTH)
    print(" canonical=")
    print_int(G_CANONICAL_COUNT)
    print(" ambiguous=")
    print_int(G_AMBIGUOUS_COUNT)
    print(" hash_mod=")
    print_int(G_SEQUENCE_HASH)
    print(" a=")
    print_int(SYMBOL_COUNTS[0])
    print(" c=")
    print_int(SYMBOL_COUNTS[1])
    print(" g=")
    print_int(SYMBOL_COUNTS[2])
    print(" t=")
    print_int(SYMBOL_COUNTS[3])
    print(" r=")
    print_int(SYMBOL_COUNTS[4])
    print(" y=")
    print_int(SYMBOL_COUNTS[5])
    print(" s=")
    print_int(SYMBOL_COUNTS[6])
    print(" w=")
    print_int(SYMBOL_COUNTS[7])
    print(" k=")
    print_int(SYMBOL_COUNTS[8])
    print(" m=")
    print_int(SYMBOL_COUNTS[9])
    print(" b=")
    print_int(SYMBOL_COUNTS[10])
    print(" d=")
    print_int(SYMBOL_COUNTS[11])
    print(" h=")
    print_int(SYMBOL_COUNTS[12])
    print(" v=")
    print_int(SYMBOL_COUNTS[13])
    print(" n=")
    print_int(SYMBOL_COUNTS[14])
    print("\n")
}

fn finish_record(offset: i64, byte: i64) with IO, Mut, Panic, Div {
    if G_SEQUENCE_LENGTH <= 0 {
        set_error(fasta_err_empty_sequence(), offset, byte)
        return
    }
    if G_REPLICON_PROFILE_MODE {
        emit_replicon_profile()
        return
    }
    if G_PIPELINE_MODE || G_EXCLUSIONS_MODE {
        if G_WINDOW_LEN > 0 { emit_pipeline_window() }
    } else {
        print_record()
    }
}

fn process_fasta_byte(ch: i64, offset: i64) with IO, Mut, Panic, Div {
    if ch == 13 { return } // CR in CRLF input

    if ch == 10 {
        if G_IN_HEADER {
            if G_HEADER_NONSPACE <= 0 {
                set_error(fasta_err_empty_header(), offset, ch)
                return
            }
            validate_header_metadata(offset)
            if G_ERROR_CODE != fasta_ok() { return }
            G_IN_HEADER = false
        }
        G_AT_LINE_START = true
        return
    }

    if G_AT_LINE_START && ch == 62 { // '>'
        if G_HAVE_HEADER {
            finish_record(offset, ch)
            if G_ERROR_CODE != fasta_ok() { return }
        }
        G_RECORD_INDEX = G_RECORD_INDEX + 1
        reset_record()
        G_HAVE_HEADER = true
        G_IN_HEADER = true
        G_AT_LINE_START = false
        return
    }

    G_AT_LINE_START = false
    if G_IN_HEADER {
        if ch != 32 && ch != 9 {
            G_HEADER_NONSPACE = G_HEADER_NONSPACE + 1
        }
        if !G_HEADER_TOKEN_DONE {
            if ch == 32 || ch == 9 {
                G_HEADER_TOKEN_DONE = true
            } else {
                if G_HEADER_ID_LEN >= HEADER_ID_BYTES {
                    set_error(fasta_err_header_token_too_long(), offset, ch)
                    return
                }
                HEADER_ID_BUF[G_HEADER_ID_LEN as usize] = ch as i8
                G_HEADER_ID_LEN = G_HEADER_ID_LEN + 1
            }
        }
        return
    }

    if !G_HAVE_HEADER {
        set_error(fasta_err_sequence_before_header(), offset, ch)
        return
    }

    let index = iupac_index(ch)
    if index < 0 {
        set_error(fasta_err_invalid_symbol(), offset, ch)
        return
    }

    SYMBOL_COUNTS[index as usize] = SYMBOL_COUNTS[index as usize] + 1
    G_SEQUENCE_LENGTH = G_SEQUENCE_LENGTH + 1
    if index < 4 {
        G_CANONICAL_COUNT = G_CANONICAL_COUNT + 1
    } else {
        G_AMBIGUOUS_COUNT = G_AMBIGUOUS_COUNT + 1
    }
    G_SEQUENCE_HASH = (G_SEQUENCE_HASH * 131 + index + 1) % FASTA_HASH_MODULUS

    if G_PIPELINE_MODE || G_EXCLUSIONS_MODE {
        WINDOW_BASES[G_WINDOW_LEN as usize] = index
        G_WINDOW_LEN = G_WINDOW_LEN + 1
        if G_WINDOW_LEN == G_WINDOW_SIZE {
            emit_pipeline_window()
        }
    }
}

fn parse_fasta_stream(path: string) -> i64 with IO, Mut, Panic, Div {
    let fd = syscall6(2, path, 0, 0, 0, 0, 0)
    if fd < 0 {
        set_error(fasta_err_open_failed(), 0, -1)
        return G_ERROR_CODE
    }

    while G_ERROR_CODE == fasta_ok() {
        let n = syscall6(0, fd, &! FASTA_BUF, FASTA_CHUNK_BYTES, 0, 0, 0)
        if n < 0 {
            set_error(fasta_err_read_failed(), G_BYTES_READ, -1)
            break
        }
        if n == 0 { break }

        G_CHUNKS_READ = G_CHUNKS_READ + 1
        var i: i64 = 0
        while i < n && G_ERROR_CODE == fasta_ok() {
            let ch = FASTA_BUF[i as usize] as i64
            let offset = G_BYTES_READ
            G_BYTES_READ = G_BYTES_READ + 1
            process_fasta_byte(ch, offset)
            i = i + 1
        }
    }

    let _closed = syscall6(3, fd, 0, 0, 0, 0, 0)
    if G_ERROR_CODE != fasta_ok() { return G_ERROR_CODE }

    if G_IN_HEADER {
        if G_HEADER_NONSPACE <= 0 {
            set_error(fasta_err_empty_header(), G_BYTES_READ, -1)
            return G_ERROR_CODE
        }
        validate_header_metadata(G_BYTES_READ)
        if G_ERROR_CODE != fasta_ok() { return G_ERROR_CODE }
        G_IN_HEADER = false
    }
    if !G_HAVE_HEADER {
        set_error(fasta_err_no_records(), G_BYTES_READ, -1)
        return G_ERROR_CODE
    }

    finish_record(G_BYTES_READ, -1)
    let products_mode = G_PIPELINE_MODE || G_EXCLUSIONS_MODE || G_REPLICON_PROFILE_MODE
    if G_ERROR_CODE == fasta_ok() && products_mode && G_RECORD_INDEX != G_METADATA_COUNT {
        set_error(fasta_err_metadata_mismatch(), G_BYTES_READ, -1)
    }
    G_ERROR_CODE
}

fn print_error() with IO {
    print("DOSA_FASTA_ERROR code=")
    print(fasta_error_name(G_ERROR_CODE))
    print(" record=")
    print_int(G_RECORD_INDEX)
    print(" offset=")
    print_int(G_ERROR_OFFSET)
    print(" byte=")
    print_int(G_ERROR_BYTE)
    print("\n")
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    let summary_mode = argc == 1
    let pipeline_mode = argc == 4 && (str_eq(get_arg(0), "--pipeline") || str_eq(get_arg(0), "--pipeline-reference"))
    let exclusions_mode = argc == 4 && str_eq(get_arg(0), "--exclusions")
    let profile_mode = argc == 5 && str_eq(get_arg(0), "--replicon-profile")
    if !summary_mode && !pipeline_mode && !exclusions_mode && !profile_mode {
        print("usage: fasta_stream_fixture <input.fa> | --pipeline <input.fa> <metadata.tsv> <parameters.flat> | --pipeline-reference <input.fa> <metadata.tsv> <parameters.flat> | --exclusions <input.fa> <metadata.tsv> <parameters.flat> | --replicon-profile <input.fa> <metadata.tsv> <parameters.flat> input_sha256=<64-hex>\n")
        return 64
    }

    reset_record()
    var input_path = get_arg(0)
    if pipeline_mode || exclusions_mode || profile_mode {
        G_PIPELINE_MODE = pipeline_mode
        G_EXCLUSIONS_MODE = exclusions_mode
        G_REPLICON_PROFILE_MODE = profile_mode
        G_SIMPLE_KERNEL = str_eq(get_arg(0), "--pipeline-reference")
        input_path = get_arg(1)
        if !load_parameters(get_arg(3)) {
            print_error()
            return G_ERROR_CODE
        }
        if !load_metadata(get_arg(2)) {
            print_error()
            return G_ERROR_CODE
        }
        if profile_mode {
            let spec = get_arg(4)
            let spec_ok = str_len(spec) == 77 && str_eq(str_span(spec, 0, 13), "input_sha256=") && is_hex_sha256(str_span(spec, 13, 77))
            if !spec_ok {
                set_error(fasta_err_param_invalid(), 0, -1)
                print_error()
                return G_ERROR_CODE
            }
            G_INPUT_SHA = str_span(spec, 13, 77)
        }
    }

    let code = parse_fasta_stream(input_path)
    if code != fasta_ok() {
        print_error()
        return code
    }

    if pipeline_mode || exclusions_mode || profile_mode { return 0 }

    print("DOSA_SOUNIO_FASTA_STREAM_OK records=")
    print_int(G_RECORD_INDEX)
    print(" bytes=")
    print_int(G_BYTES_READ)
    print(" chunks=")
    print_int(G_CHUNKS_READ)
    print(" chunk_bytes=")
    print_int(FASTA_CHUNK_BYTES)
    print("\n")
    0
}

//@ run-pass

// Null-generator quality fixture for Darwin Atlas Fase N.
//
// Standalone statistical-quality harness for BOTH engineering null engines.
// It replicates the canonical engines exactly, byte for byte:
//
//   mono  (sounio/src/fasta_stream_fixture.sio):
//         glibc-constant LCG mod 2^31; per-replicate state
//         (seed_base + window_start*1000003 + record_index*1000033 +
//          metric_index*100043 + replicate*1009) mod 2^31, then Fisher-Yates
//         with j = state mod (i+1). seed_base is the first 8 hex digits of
//         seed_material, mirroring null_seed_base_from_sha
//         (lcg31_sha8_fixture_v1). record_index=1 and metric_index=0 are
//         fixed documented quality-harness constants; window_start comes
//         from the case row.
//   dinuc (sounio/src/dinucleotide_null_fixture.sio, ADR-0003
//         euler_wilson_fixed_endpoints_v1): L'Ecuyer combined generator,
//         rejection-sampled bounded draws, replicate substreams separated by
//         2^20 jumps, Wilson loop-erased arborescence, outgoing edge orders
//         with the tree edge last. seed_material is the 16-hex seed64.
//
// Output: one block-header line per case
//   #case=<case_id> engine=<engine> draws=<draws> seed_material=<hex> bases=<bases>
// followed by exactly <draws> lines, one shuffled sequence per line
// (replicate index = line position inside the block). The statistical
// analysis lives entirely in the independent Julia validator; this fixture
// only produces deterministic draws.
//
// Exit codes mirror the canonical fixtures: 64 usage, 12 malformed input,
// 0 success. No scientific claim: this is an engineering quality gate.

const MAX_BASES: i64 = 16
const MAX_EDGES: i64 = 15
const CASE_SPAN_MAX: i64 = 4096
const MAX_DRAWS: i64 = 1000000

// mono engine constants (identical to fasta_stream_fixture.sio)
const NULL_LCG_MODULUS: i64 = 2147483648
const NULL_LCG_MULTIPLIER: i64 = 1103515245
const NULL_LCG_INCREMENT: i64 = 12345
const QUALITY_RECORD_INDEX: i64 = 1
const QUALITY_METRIC_INDEX: i64 = 0

// dinuc engine constants (identical to dinucleotide_null_fixture.sio)
const RNG_M1: i64 = 2147483563
const RNG_M2: i64 = 2147483399
const RNG_A1: i64 = 40014
const RNG_A2: i64 = 40692
const RNG_JUMP1: i64 = 993186111
const RNG_JUMP2: i64 = 1744472178

var INPUT_BASES: [i64; 16] = [0; 16]
var OUTPUT_BASES: [i64; 16] = [0; 16]

// mono engine state
var WINDOW_BASES: [i64; 16] = [0; 16]
var G_NULL_STATE: i64 = 0

// dinuc engine state
var EDGE_SRC: [i64; 15] = [0; 15]
var EDGE_DST: [i64; 15] = [0; 15]
var OUT_DEGREE: [i64; 4] = [0; 4]
var ORDERED_EDGES: [i64; 64] = [0; 64]
var ORDER_CURSOR: [i64; 4] = [0; 4]
var TREE_EDGE: [i64; 4] = [-1; 4]
var NEXT_EDGE: [i64; 4] = [-1; 4]
var IN_TREE: [bool; 4] = [false; 4]
var ACTIVE_VERTEX: [bool; 4] = [false; 4]
var G_RNG1: i64 = 1
var G_RNG2: i64 = 1

fn span(text: string, start: i64, finish: i64) -> string with Mut, Panic, Div {
    if start < 0 || finish < start { return "" }
    let n = finish - start
    if n <= 0 || n > CASE_SPAN_MAX { return "" }
    var buf: [i8; 4096] = [0; 4096]
    var i: i64 = 0
    while i < n {
        buf[i as usize] = str_char_at(text, start + i) as i8
        i = i + 1
    }
    str_from_bytes(buf, n)
}

fn field(line: string, target: i64) -> string with Mut, Panic, Div {
    let n = str_len(line)
    var index: i64 = 0
    var start: i64 = 0
    var i: i64 = 0
    while i <= n {
        if i == n || str_char_at(line, i) == 9 {
            if index == target { return span(line, start, i) }
            index = index + 1
            start = i + 1
        }
        i = i + 1
    }
    ""
}

fn field_count(line: string) -> i64 with Mut, Panic, Div {
    var count: i64 = 1
    var i: i64 = 0
    while i < str_len(line) {
        if str_char_at(line, i) == 9 { count = count + 1 }
        i = i + 1
    }
    count
}

fn parse_nonnegative(raw: string) -> i64 with Mut, Panic, Div {
    if str_len(raw) <= 0 { return -1 }
    var value: i64 = 0
    var i: i64 = 0
    while i < str_len(raw) {
        let ch = str_char_at(raw, i)
        if ch < 48 || ch > 57 { return -1 }
        value = value * 10 + ch - 48
        i = i + 1
    }
    value
}

fn hex_value(ch: i64) -> i64 {
    if ch >= 48 && ch <= 57 { return ch - 48 }
    if ch >= 97 && ch <= 102 { return ch - 87 }
    -1
}

fn parse_hex8(raw: string, start: i64) -> i64 with Mut, Panic, Div {
    var value: i64 = 0
    var i: i64 = 0
    while i < 8 {
        let digit = hex_value(str_char_at(raw, start + i))
        if digit < 0 { return -1 }
        value = value * 16 + digit
        i = i + 1
    }
    value
}

fn identifier_ok(raw: string) -> bool with Mut, Panic, Div {
    if str_len(raw) <= 0 { return false }
    var i: i64 = 0
    while i < str_len(raw) {
        let ch = str_char_at(raw, i)
        let ok = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
            || (ch >= 48 && ch <= 57) || ch == 46 || ch == 95 || ch == 45
        if !ok { return false }
        i = i + 1
    }
    true
}

fn base_code(ch: i64) -> i64 {
    if ch == 65 { return 0 }
    if ch == 67 { return 1 }
    if ch == 71 { return 2 }
    if ch == 84 { return 3 }
    -1
}

// ---------------------------------------------------------------- mono engine

fn null_lcg_step() with Mut, Div {
    G_NULL_STATE = (G_NULL_STATE * NULL_LCG_MULTIPLIER + NULL_LCG_INCREMENT) % NULL_LCG_MODULUS
}

fn mono_seed_state(seed_base: i64, window_start: i64, replicate: i64) with Mut, Div {
    G_NULL_STATE = (seed_base
        + window_start * 1000003
        + QUALITY_RECORD_INDEX * 1000033
        + QUALITY_METRIC_INDEX * 100043
        + replicate * 1009) % NULL_LCG_MODULUS
}

fn mono_shuffle_window(length: i64) with Mut, Panic, Div {
    var i: i64 = length - 1
    while i >= 1 {
        null_lcg_step()
        let j = G_NULL_STATE % (i + 1)
        let tmp = WINDOW_BASES[i as usize]
        WINDOW_BASES[i as usize] = WINDOW_BASES[j as usize]
        WINDOW_BASES[j as usize] = tmp
        i = i - 1
    }
}

// --------------------------------------------------------------- dinuc engine

fn rng_step() -> i64 with Mut, Div {
    G_RNG1 = (RNG_A1 * G_RNG1) % RNG_M1
    G_RNG2 = (RNG_A2 * G_RNG2) % RNG_M2
    var value = G_RNG1 - G_RNG2
    if value < 1 { value = value + RNG_M1 - 1 }
    value - 1
}

fn rng_bounded(bound: i64) -> i64 with Mut, Div {
    if bound <= 1 { return 0 }
    let range = RNG_M1 - 1
    let limit = range - (range % bound)
    while true {
        let value = rng_step()
        if value < limit { return value % bound }
    }
    0
}

fn seed_replicate(seed_hi: i64, seed_lo: i64, replicate: i64) with Mut, Div {
    G_RNG1 = 1 + (seed_hi % (RNG_M1 - 1))
    G_RNG2 = 1 + (seed_lo % (RNG_M2 - 1))
    var i: i64 = 1
    while i < replicate {
        G_RNG1 = (G_RNG1 * RNG_JUMP1) % RNG_M1
        G_RNG2 = (G_RNG2 * RNG_JUMP2) % RNG_M2
        i = i + 1
    }
}

fn random_out_edge(vertex: i64) -> i64 with Mut, Panic, Div {
    let rank = rng_bounded(OUT_DEGREE[vertex as usize])
    var seen: i64 = 0
    var edge: i64 = 0
    while edge < MAX_EDGES {
        if EDGE_SRC[edge as usize] == vertex {
            if seen == rank { return edge }
            seen = seen + 1
        }
        edge = edge + 1
    }
    -1
}

fn shuffle_window(length: i64, seed_hi: i64, seed_lo: i64, replicate: i64) -> bool with Mut, Panic, Div {
    let edge_count = length - 1
    let root = INPUT_BASES[(length - 1) as usize]
    var v: i64 = 0
    while v < 4 {
        OUT_DEGREE[v as usize] = 0
        ORDER_CURSOR[v as usize] = 0
        TREE_EDGE[v as usize] = -1
        NEXT_EDGE[v as usize] = -1
        IN_TREE[v as usize] = false
        ACTIVE_VERTEX[v as usize] = false
        v = v + 1
    }
    var edge: i64 = 0
    while edge < MAX_EDGES {
        EDGE_SRC[edge as usize] = -1
        EDGE_DST[edge as usize] = -1
        edge = edge + 1
    }
    edge = 0
    while edge < edge_count {
        let source = INPUT_BASES[edge as usize]
        let target = INPUT_BASES[(edge + 1) as usize]
        EDGE_SRC[edge as usize] = source
        EDGE_DST[edge as usize] = target
        OUT_DEGREE[source as usize] = OUT_DEGREE[source as usize] + 1
        ACTIVE_VERTEX[source as usize] = true
        ACTIVE_VERTEX[target as usize] = true
        edge = edge + 1
    }

    seed_replicate(seed_hi, seed_lo, replicate)
    v = 0
    while v < 4 {
        if !ACTIVE_VERTEX[v as usize] { IN_TREE[v as usize] = true }
        v = v + 1
    }
    IN_TREE[root as usize] = true

    // Wilson loop-erased random walks. NEXT_EDGE is overwritten whenever a
    // loop is revisited, which is the four-vertex form of loop erasure.
    v = 0
    while v < 4 {
        var current = v
        var safety: i64 = 0
        while !IN_TREE[current as usize] {
            if OUT_DEGREE[current as usize] <= 0 { return false }
            let chosen = random_out_edge(current)
            if chosen < 0 { return false }
            NEXT_EDGE[current as usize] = chosen
            current = EDGE_DST[chosen as usize]
            safety = safety + 1
            if safety > 4096 { return false }
        }
        current = v
        while !IN_TREE[current as usize] {
            let chosen = NEXT_EDGE[current as usize]
            if chosen < 0 { return false }
            IN_TREE[current as usize] = true
            TREE_EDGE[current as usize] = chosen
            current = EDGE_DST[chosen as usize]
        }
        v = v + 1
    }

    // Random outgoing-edge orders, with the arborescence edge last.
    v = 0
    while v < 4 {
        var count: i64 = 0
        edge = 0
        while edge < edge_count {
            if EDGE_SRC[edge as usize] == v {
                ORDERED_EDGES[(v * 16 + count) as usize] = edge
                count = count + 1
            }
            edge = edge + 1
        }
        var i = count - 1
        while i > 0 {
            let j = rng_bounded(i + 1)
            let left = (v * 16 + i) as usize
            let right = (v * 16 + j) as usize
            let temporary = ORDERED_EDGES[left]
            ORDERED_EDGES[left] = ORDERED_EDGES[right]
            ORDERED_EDGES[right] = temporary
            i = i - 1
        }
        if v != root && ACTIVE_VERTEX[v as usize] {
            let tree = TREE_EDGE[v as usize]
            var position: i64 = -1
            i = 0
            while i < count {
                if ORDERED_EDGES[(v * 16 + i) as usize] == tree { position = i }
                i = i + 1
            }
            if position < 0 { return false }
            let at = (v * 16 + position) as usize
            let last = (v * 16 + count - 1) as usize
            let temporary = ORDERED_EDGES[at]
            ORDERED_EDGES[at] = ORDERED_EDGES[last]
            ORDERED_EDGES[last] = temporary
        }
        v = v + 1
    }

    var current = INPUT_BASES[0]
    OUTPUT_BASES[0] = current
    edge = 0
    while edge < edge_count {
        let cursor = ORDER_CURSOR[current as usize]
        if cursor >= OUT_DEGREE[current as usize] { return false }
        let chosen = ORDERED_EDGES[(current * 16 + cursor) as usize]
        if EDGE_SRC[chosen as usize] != current { return false }
        ORDER_CURSOR[current as usize] = cursor + 1
        current = EDGE_DST[chosen as usize]
        OUTPUT_BASES[(edge + 1) as usize] = current
        edge = edge + 1
    }
    current == root
}

// ------------------------------------------------------------------- emission

fn emit_output(length: i64) with IO, Mut, Panic, Div {
    var bytes: [i8; 16] = [0; 16]
    var i: i64 = 0
    while i < length {
        let base = OUTPUT_BASES[i as usize]
        if base == 0 { bytes[i as usize] = 65 }
        if base == 1 { bytes[i as usize] = 67 }
        if base == 2 { bytes[i as usize] = 71 }
        if base == 3 { bytes[i as usize] = 84 }
        i = i + 1
    }
    let sequence = str_from_bytes(bytes, length)
    print(sequence)
    print("\n")
}

fn process_case(line: string) -> bool with IO, Mut, Panic, Div {
    if field_count(line) != 7 { return false }
    let case_id = field(line, 0)
    let engine = field(line, 1)
    let accession = field(line, 2)
    let window_start = parse_nonnegative(field(line, 3))
    let seed_material = field(line, 4)
    let bases = field(line, 5)
    let draws = parse_nonnegative(field(line, 6))
    let length = str_len(bases)
    if !identifier_ok(case_id) || !identifier_ok(accession) { return false }
    if window_start < 0 || str_len(seed_material) != 16 || length < 1 || length > MAX_BASES { return false }
    if draws < 1 || draws > MAX_DRAWS { return false }
    let seed_hi = parse_hex8(seed_material, 0)
    let seed_lo = parse_hex8(seed_material, 8)
    if seed_hi < 0 || seed_lo < 0 { return false }
    var i: i64 = 0
    while i < length {
        let base = base_code(str_char_at(bases, i))
        if base < 0 { return false }
        INPUT_BASES[i as usize] = base
        i = i + 1
    }

    print("#case=")
    print(case_id)
    print(" engine=")
    print(engine)
    print(" draws=")
    print_int(draws)
    print(" seed_material=")
    print(seed_material)
    print(" bases=")
    print(bases)
    print("\n")

    var replicate: i64 = 1
    if str_eq(engine, "mono") {
        while replicate <= draws {
            i = 0
            while i < length {
                WINDOW_BASES[i as usize] = INPUT_BASES[i as usize]
                i = i + 1
            }
            mono_seed_state(seed_hi, window_start, replicate)
            mono_shuffle_window(length)
            i = 0
            while i < length {
                OUTPUT_BASES[i as usize] = WINDOW_BASES[i as usize]
                i = i + 1
            }
            emit_output(length)
            replicate = replicate + 1
        }
        return true
    }
    if str_eq(engine, "dinuc") {
        while replicate <= draws {
            if !shuffle_window(length, seed_hi, seed_lo, replicate) { return false }
            emit_output(length)
            replicate = replicate + 1
        }
        return true
    }
    false
}

fn main() -> i64 with IO, Mut, Panic, Div {
    if arg_count() != 1 {
        println("usage: null_quality_fixture <cases.tsv>")
        return 64
    }
    let text = read_file(get_arg(0))
    let n = str_len(text)
    if n <= 0 { return 12 }
    var start: i64 = 0
    var logical_line: i64 = 0
    var cases: i64 = 0
    while start <= n {
        var finish = start
        while finish < n && str_char_at(text, finish) != 10 { finish = finish + 1 }
        var line_end = finish
        if line_end > start && str_char_at(text, line_end - 1) == 13 { line_end = line_end - 1 }
        let line = span(text, start, line_end)
        if str_len(line) > 0 {
            if logical_line == 0 {
                if !str_eq(line, "case_id\tengine\taccession_version\twindow_start\tseed_material\tbases\tdraws") {
                    return 12
                }
            } else {
                if !process_case(line) { return 12 }
                cases = cases + 1
            }
            logical_line = logical_line + 1
        }
        if finish >= n { break }
        start = finish + 1
    }
    if cases <= 0 { return 12 }
    0
}

cff-version: 1.2.0
title: "Darwin Operator Symmetry Atlas (DOSA)"
message: "This U0-dev tree is not a data release. Cite a published DOSA DOI, not this development branch."
type: software
authors:
  - family-names: "Agourakis"
    given-names: "Demetrios Chiuratto"
    email: "demetrios@agourakis.med.br"
    affiliation: "Independent Researcher"

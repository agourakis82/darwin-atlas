{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/dosa_v3_source_manifest.schema.json",
  "title": "DOSA v3 externally recoverable source manifest",
  "description": "Immutable NCBI source closure. It binds the fresh query object and file hash, pinned acquisition tools, versioned assembly/sequence accessions, package/catalog/checksum verification, and immutable FASTA/GBFF/sequence-report assets. Every path is package-relative; private absolute paths are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "retrieved_utc",
    "source_provider",
    "query",
    "acquisition_tools",
    "package",
    "selected_records",
    "package_assets"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "manifest_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
    "retrieved_utc": {"type": "string", "format": "date-time"},
    "source_provider": {"const": "NCBI_Datasets"},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "object"],
      "properties": {
        "path": {"$ref": "dosa_v3_common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "dosa_v3_common.schema.json#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "object": {"type": "object", "minProperties": 1}
      }
    },
    "acquisition_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasets", "dataformat"],
      "properties": {
        "datasets": {"$ref": "#/$defs/toolBinding"},
        "dataformat": {"$ref": "#/$defs/toolBinding"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "source_url",
        "package_root",
        "dehydrated_archive",
        "catalog",
        "checksum_manifest",
        "catalog_verified",
        "package_checksums_verified",
        "selected_assets_complete"
      ],
      "properties": {
        "package_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "package_root": {"$ref": "dosa_v3_common.schema.json#/$defs/relativePath"},
        "dehydrated_archive": {"$ref": "#/$defs/immutableFile"},
        "catalog": {"$ref": "#/$defs/immutableFile"},
        "checksum_manifest": {"$ref": "#/$defs/immutableFile"},
        "catalog_verified": {"const": true},
        "package_checksums_verified": {"const": true},
        "selected_assets_complete": {"const": true}
      }
    },
    "selected_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_record_id", "replicon_id", "assembly_accession_version", "sequence_accession_version", "required_asset_kinds"],
        "properties": {
          "source_record_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
          "replicon_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
          "assembly_accession_version": {"type": "string", "pattern": "^[A-Za-z]+_[0-9]+\\.[0-9]+$"},
          "sequence_accession_version": {"type": "string", "pattern": "^[A-Za-z]+_[0-9]+\\.[0-9]+$"},
          "required_asset_kinds": {"const": ["fasta", "gbff", "sequence_report"]}
        }
      }
    },
    "package_assets": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/packageAsset"},
      "allOf": [
        {"contains": {"properties": {"asset_kind": {"const": "fasta"}}}},
        {"contains": {"properties": {"asset_kind": {"const": "gbff"}}}},
        {"contains": {"properties": {"asset_kind": {"const": "sequence_report"}}}}
      ]
    }
  },
  "$defs": {
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_url", "sha256", "size_bytes"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"$ref": "dosa_v3_common.schema.json#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "immutableFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "dosa_v3_common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "dosa_v3_common.schema.json#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "packageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_kind",
        "assembly_accession_version",
        "selected_record_ids",
        "source_url",
        "package_path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "asset_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
        "asset_kind": {"enum": ["fasta", "gbff", "sequence_report"]},
        "assembly_accession_version": {"type": "string", "pattern": "^[A-Za-z]+_[0-9]+\\.[0-9]+$"},
        "sequence_accession_version": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z]+_[0-9]+\\.[0-9]+$",
          "description": "Versioned sequence accession when the package file is replicon-specific; null only for an assembly-level immutable asset referenced by selected_record_ids."
        },
        "selected_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "dosa_v3_common.schema.json#/$defs/id"}
        },
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "package_path": {"$ref": "dosa_v3_common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "dosa_v3_common.schema.json#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}

  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "description": "0.2.0 supersedes 0.1.0: it adds parameters_sha256, the per-k kmer_<k>_unavailable_reason fields, and the k=5..8 blocks. The interpretation of every field that existed in 0.1.0 is unchanged; the frozen 4/4 fixture (parameters_k4.json) is the migration regression."
    },
    "metric_version": {
      "const": "0.1.0"
    },
    "parameters_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical pipeline parameter JSON artifact, repeated on every line; binds the output to an exact parameter instance."
    },
    "assembly_accession_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sequence_accession_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "replicon_class": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "declared_topology": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "enum": [
        "circular",
        "linear",
        "unknown"
      ]
    },
    "source_scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "record_index": {
      "type": "integer",
      "minimum": 0
    },
    "window_index": {
      "type": "integer",
      "minimum": 0
    },
    "window_start": {
      "type": "integer",
      "minimum": 0
    },
    "window_end": {
      "type": "integer",
      "minimum": 0
    },
    "window_length": {
      "type": "integer",
      "minimum": 0
    },
    "ambiguity_policy": {
      "const": "canonical_only"
    },
    "status": {
      "enum": [
        "ok",
        "excluded"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "PARTIAL_WINDOW",
            "AMBIGUOUS_WINDOW"
          ]
        }
      ]
    },
    "effective_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Equals window_length when status=ok, 0 when excluded."
    },
    "delta_R_mismatches": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "delta_RC_mismatches": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "denominator": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "delta_R": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "description": "delta_R_mismatches/denominator, serialized with exactly six fractional digits."
    },
    "delta_RC": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "description": "delta_RC_mismatches/denominator, serialized with exactly six fractional digits."
    },
    "fixed_R": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "fixed_RC": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "kmer_ambiguity_policy": {
      "const": "masked"
    },
    "kmer_min_effective_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Executable-fixture parameter (from the canonical parameter JSON), not the final pilot threshold."
    },
    "kmer_1_effective_count": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "description": "Canonical 1-mer count after the masked ambiguity policy; independent of the positional status. Null iff kmer_1_unavailable_reason is K_OUT_OF_CONFIGURED_RANGE."
    },
    "kmer_1_unavailable_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "K_OUT_OF_CONFIGURED_RANGE",
            "INSUFFICIENT_EFFECTIVE_KMERS"
          ]
        }
      ],
      "description": "null when the imbalance fields are populated; K_OUT_OF_CONFIGURED_RANGE when k exceeds the configured k_max; INSUFFICIENT_EFFECTIVE_KMERS when the effective count is below kmer_min_effective_count."
    },

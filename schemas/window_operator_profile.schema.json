          },
          "delta_R_mismatches": {
            "type": "integer"
          },
          "delta_RC_mismatches": {
            "type": "integer"
          },
          "denominator": {
            "const": 4
          },
          "delta_R": {
            "type": "number"
          },
          "delta_RC": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/pipeline_parameters.schema.json",
  "title": "DOSA mini-pipeline parameters",
  "description": "Versioned parameter contract for the Sounio mini-pipeline. The canonical artifact is this JSON; the runner validates it (including cross-field constraints), hashes it with SHA-256, and renders a strict fixed-order key=value file for the executable. Cross-field rules for this phase: stride == window_size and k_max <= window_size. min_kmer_effective_count=1 is an executable-fixture parameter, not a pilot decision. null_model/null_replicates are OPTIONAL additive keys: when both are absent the executable behaves exactly as before (13-line flat rendering); when present they append two lines to the flat rendering and null_model=none requires null_replicates=0. mononucleotide_shuffle with the fixture replicate ceiling 64 is an executable-fixture null, not the ADR-0002 pilot null (primary model, replicate count, and seed derivation remain proposed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_version",
    "window_size",
    "stride",
    "k_min",
    "k_max",
    "min_kmer_effective_count",
    "positional_ambiguity_policy",
    "kmer_ambiguity_policy",
    "coordinate_system",
    "window_wraparound",
    "output_order"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "specification_version": {
      "const": "0.1.0"
    },
    "window_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "stride": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "k_min": {
      "const": 1
    },
    "k_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "min_kmer_effective_count": {
      "type": "integer",
      "minimum": 1
    },
    "positional_ambiguity_policy": {
      "const": "canonical_only"
    },
    "kmer_ambiguity_policy": {
      "const": "masked"
    },
    "coordinate_system": {
      "const": "zero_based_half_open"
    },
    "window_wraparound": {
      "const": false
    },
    "output_order": {
      "const": "manifest_record_then_window_start"
    },
    "null_model": {
      "enum": [
        "none",
        "mononucleotide_shuffle"
      ]
    },
    "null_replicates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "null_model"
        ],
        "properties": {
          "null_model": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "null_replicates": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "null_model"
        ],
        "properties": {
          "null_model": {
            "const": "mononucleotide_shuffle"
          }
        }
      },
      "then": {
        "properties": {
          "null_replicates": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "null_replicates"
        ]
      }
    },
    {
      "if": {
        "required": [
          "null_replicates"
        ]
      },
      "then": {
        "required": [
          "null_model"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "window_size": {
            "const": 1
          }
        },
        "required": [
          "window_size"
        ]
      },
      "then": {
        "properties": {
          "stride": {
            "const": 1
          },
          "k_max": {
            "maximum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "window_size": {
            "const": 2
          }
        },
        "required": [
          "window_size"
        ]
      },
      "then": {
        "properties": {
          "stride": {
            "const": 2
          },

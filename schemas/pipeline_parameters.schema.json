  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_version",
    "window_size",
    "stride",
    "k_min",
    "k_max",
    "min_kmer_effective_count",
    "positional_ambiguity_policy",
    "kmer_ambiguity_policy",
    "coordinate_system",
    "window_wraparound",
    "output_order"
  ],

      "const": "1.0.0"
    },
    "specification_version": {
      "const": "0.1.0"
    },
    "window_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "stride": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "k_min": {
      "const": 1
    },
    "k_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "min_kmer_effective_count": {
      "type": "integer",
      "minimum": 1
    },
    "positional_ambiguity_policy": {
      "const": "canonical_only"
    },
    "kmer_ambiguity_policy": {
      "const": "masked"
    },
    "coordinate_system": {
      "const": "zero_based_half_open"
    },
    "window_wraparound": {
      "const": false
    },
    "output_order": {
      "const": "manifest_record_then_window_start"
    }
  },

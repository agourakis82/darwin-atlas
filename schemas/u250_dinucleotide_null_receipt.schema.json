{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin-atlas.example/schemas/u250_dinucleotide_null_receipt.schema.json",
  "title": "Darwin Atlas U250 exact dinucleotide-null fixture receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_kind", "state", "engineering_scope",
    "semantic_scope", "adr_0002_status", "adr_0003_status",
    "pilot_primary_candidate", "pilot_null_primary", "scientific_claim",
    "performance_claim", "run_id", "started_utc", "finished_utc",
    "atlas_source", "sounio", "algorithm", "builder", "platform",
    "runtime", "fixture", "artifacts", "validation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_kind": { "const": "u250_dinucleotide_null_hardware" },
    "state": { "const": "validated" },
    "engineering_scope": { "const": true },
    "semantic_scope": { "const": "exact_dinucleotide_preserving_fixture" },
    "adr_0002_status": { "const": "proposed" },
    "adr_0003_status": { "const": "accepted" },
    "pilot_primary_candidate": { "const": true },
    "pilot_null_primary": { "const": false },
    "scientific_claim": { "const": false },
    "performance_claim": { "const": false },
    "run_id": { "type": "string", "pattern": "^dinucleotide-null-[0-9a-f]{7}-[0-9]{8}T[0-9]{6}Z$" },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": "string", "format": "date-time" },
    "atlas_source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": { "commit": { "$ref": "#/$defs/sha1" }, "dirty": { "const": false } }
    },
    "sounio": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "launcher_sha256", "source_sha256", "executable_sha256", "artifact_sha256"],
      "properties": {
        "repository": { "const": "https://github.com/sounio-lang/sounio.git" },
        "commit": { "$ref": "#/$defs/sha1" },
        "launcher_sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "algorithm": {
      "type": "object", "additionalProperties": false,
      "required": ["shuffle", "seed_derivation", "rng", "replicate_substream_steps", "bounded_draw"],
      "properties": {
        "shuffle": { "const": "euler_wilson_fixed_endpoints_v1" },
        "seed_derivation": { "const": "sha256_parameters_accession_window_first64be_v1" },
        "rng": { "const": "lecuyer_combined31_substream20_sha64_v1" },
        "replicate_substream_steps": { "const": 1048576 },
        "bounded_draw": { "const": "rejection_sampling" }
      }
    },
    "builder": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "os", "vitis_version", "vitis_build", "errors", "critical_warnings"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "vitis_version": { "const": "2025.1" },
        "vitis_build": { "const": "6137779" },
        "errors": { "type": "integer", "minimum": 0 },
        "critical_warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "xpfm_sha256", "xsa_sha256", "kernel_frequency_mhz"],
      "properties": {
        "name": { "const": "xilinx_u250_gen3x16_xdma_4_1_202210_1" },
        "xpfm_sha256": { "$ref": "#/$defs/sha256" },
        "xsa_sha256": { "$ref": "#/$defs/sha256" },
        "kernel_frequency_mhz": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["kubernetes_node", "bdf", "shell", "device_ready", "xrt_version", "xrt_hash"],
      "properties": {
        "kubernetes_node": { "const": "dl380-proxmox" },
        "bdf": { "const": "0000:d8:00.1" },
        "shell": { "const": "xilinx_u250_gen3x16_xdma_shell_4_1" },
        "device_ready": { "const": true },
        "xrt_version": { "const": "2.23.0" },
        "xrt_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["cases", "replicates", "sequence_draws", "base_slots", "tolerance", "parameters_sha256", "cases_sha256", "generated_header_sha256"],
      "properties": {
        "cases": { "const": 8 }, "replicates": { "const": 8 },
        "sequence_draws": { "const": 64 }, "base_slots": { "const": 1024 },
        "tolerance": { "const": 0 },
        "parameters_sha256": { "$ref": "#/$defs/sha256" },
        "cases_sha256": { "$ref": "#/$defs/sha256" },
        "generated_header_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": { "enum": ["kernel_source", "xo", "xclbin", "host_binary"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["sounio_marker", "julia_marker", "csim_marker", "hardware_marker", "exit_code", "hardware_log_sha256"],
      "properties": {
        "sounio_marker": { "const": "DINUCLEOTIDE_NULL_DIFFERENTIAL_PASS" },
        "julia_marker": { "const": "DINUCLEOTIDE_JULIA_DIFFERENTIAL_PASS" },
        "csim_marker": { "const": "U250_DINUCLEOTIDE_CSIM_PASS" },
        "hardware_marker": { "const": "U250_DINUCLEOTIDE_HARDWARE_PASS" },
        "exit_code": { "const": 0 },
        "hardware_log_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/dosa_v3_exclusion.schema.json",
  "title": "DOSA v3 excluded_records.parquet row",
  "description": "One explicit replicon-, window-, or metric-level exclusion. Null coordinates identify a replicon-level exclusion; metric-level rows name the exact operator and k where applicable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "replicon_id", "exclusion_level", "window_size", "window_index", "window_start", "window_end", "metric_id", "k", "reason_code"],
  "properties": {
    "run_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
    "replicon_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
    "exclusion_level": {"enum": ["replicon", "window", "metric"]},
    "window_size": {"type": ["integer", "null"], "enum": [null, 16, 100, 500, 1000]},
    "window_index": {"type": ["integer", "null"], "minimum": 0},
    "window_start": {"type": ["integer", "null"], "minimum": 0},
    "window_end": {"type": ["integer", "null"], "minimum": 1},
    "metric_id": {"type": ["string", "null"], "enum": [null, "positional_r", "positional_rc", "kmer_r", "kmer_rc"]},
    "k": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
    "reason_code": {
      "enum": [
        "PARTIAL_WINDOW",
        "AMBIGUOUS_WINDOW",
        "INSUFFICIENT_EFFECTIVE_KMERS",
        "NULL_INPUT_NOT_ACGT",
        "NULL_GENERATOR_FAILED",
        "NULL_DRAWS_INCOMPLETE",
        "SOURCE_RECORD_EXCLUDED"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exclusion_level": {"const": "replicon"}}},
      "then": {
        "properties": {
          "window_size": {"type": "null"},
          "window_index": {"type": "null"},
          "window_start": {"type": "null"},
          "window_end": {"type": "null"},
          "metric_id": {"type": "null"},
          "k": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"exclusion_level": {"const": "window"}}},
      "then": {
        "properties": {
          "window_size": {"type": "integer"},
          "window_index": {"type": "integer"},
          "window_start": {"type": "integer"},
          "window_end": {"type": "integer"},
          "metric_id": {"type": "null"},
          "k": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"exclusion_level": {"const": "metric"}}},
      "then": {
        "properties": {
          "window_size": {"type": "integer"},
          "window_index": {"type": "integer"},
          "window_start": {"type": "integer"},
          "window_end": {"type": "integer"},
          "metric_id": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"metric_id": {"enum": ["positional_r", "positional_rc"]}}},
      "then": {"properties": {"k": {"type": "null"}}}
    },
    {
      "if": {"properties": {"metric_id": {"const": "kmer_r"}}},
      "then": {"properties": {"k": {"type": "integer", "minimum": 2, "maximum": 8}}}
    },
    {
      "if": {"properties": {"metric_id": {"const": "kmer_rc"}}},
      "then": {"properties": {"k": {"type": "integer", "minimum": 1, "maximum": 8}}}
    }
  ]
}

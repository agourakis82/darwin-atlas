{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/cohort_assemblies.schema.json",
  "title": "DOSA cohort_assemblies product line",
  "description": "One cohort_assemblies JSONL line per acquired assembly (specification 0.1.0 section 11.1). All fields are acquisition metadata bound to the frozen cohort manifest; no scientific observations are computed for this product. The provenance extension fields bind the exact NCBI Datasets CLI, download package, and per-assembly FASTA bytes. Field order is fixed as listed in required and is enforced byte-exact by the differential validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort",
    "assembly_accession_version",
    "taxid",
    "organism_name",
    "refseq_category",
    "assembly_level",
    "retrieval_utc",
    "datasets_version",
    "datasets_cli_sha256",
    "package_md5",
    "package_md5_scope",
    "download_package_sha256",
    "topology_package_sha256",
    "genomic_fna_sha256",
    "included"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "cohort": {
      "type": "string",
      "minLength": 1
    },
    "assembly_accession_version": {
      "type": "string",
      "pattern": "^GCF_[0-9]+\\.[0-9]+$"
    },
    "taxid": {
      "type": "integer",
      "minimum": 1
    },
    "organism_name": {
      "type": "string",
      "minLength": 1
    },
    "refseq_category": {
      "type": "string",
      "minLength": 1
    },
    "assembly_level": {
      "const": "Complete Genome"
    },
    "retrieval_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "datasets_version": {
      "type": "string",
      "minLength": 1
    },
    "datasets_cli_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "package_md5_scope": {
      "type": "string",
      "minLength": 1
    },
    "download_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "topology_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "genomic_fna_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "included": {
      "type": "boolean"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/run_receipt.schema.json",
  "title": "Darwin Atlas run receipt",
  "description": "Binds one Sounio producer run and its optional independent Julia validation to immutable inputs and outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_version",
    "run_id",
    "state",
    "started_utc",
    "finished_utc",
    "atlas_source",
    "producer",
    "acquisition",
    "input_manifest_sha256",
    "parameters_sha256",
    "commands",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "specification_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {
      "type": "string",
      "enum": ["generated_unvalidated", "validated", "failed"]
    },
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "atlas_source": {"$ref": "#/$defs/sourceBinding"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "language_source_commit",
        "compiler_path",
        "compiler_version",
        "compiler_sha256",
        "executable_sha256"
      ],
      "properties": {
        "language": {"const": "Sounio"},
        "language_source_commit": {"$ref": "#/$defs/gitCommit"},
        "compiler_path": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "compiler_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "retrieved_utc", "filters", "package_checksums_verified"],
      "properties": {
        "tool": {"const": "NCBI Datasets CLI"},
        "version": {"type": "string", "minLength": 1},
        "retrieved_utc": {"type": "string", "format": "date-time"},
        "filters": {"type": "object"},
        "package_checksums_verified": {"const": true}
      }
    },
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "parameters_sha256": {"$ref": "#/$defs/sha256"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "exit_code": {"type": "integer"},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "validator": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "version",
            "project_manifest_sha256",
            "sample_definition_sha256",
            "report_sha256",
            "status"
          ],
          "properties": {
            "language": {"const": "Julia"},
            "version": {"type": "string", "minLength": 1},
            "project_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "sample_definition_sha256": {"$ref": "#/$defs/sha256"},
            "report_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"type": "string", "enum": ["pass", "fail"]},
            "absolute_tolerance": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitCommit"},
        "dirty": {"type": "boolean"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "schema": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "validated"}}},
      "then": {
        "required": ["validator"],
        "properties": {
          "atlas_source": {
            "type": "object",
            "properties": {"dirty": {"const": false}}
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"exit_code": {"const": 0}}
            }
          },
          "artifacts": {"type": "array", "minItems": 1},
          "validator": {
            "type": "object",
            "properties": {"status": {"const": "pass"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "generated_unvalidated"}
        }
      },
      "then": {
        "properties": {
          "artifacts": {"type": "array", "minItems": 1}
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agourakis82/darwin-atlas/schemas/dosa_v3_summary.schema.json",
  "title": "DOSA v3 replicon_operator_summary.parquet row",
  "description": "A replicon/profile/operator roll-up derived from eligible public window rows. It retains exact observed and null values and is not an inferential p/q output.",
  "x-dosa-cross-field-invariants": [
    "windows_eligible + windows_excluded == windows_total",
    "available observed.denominator == effective_count",
    "available null_summary.tail_lt + tail_eq + tail_gt == null_summary.n",
    "available null_summary.q025 <= q500 <= q975"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "replicon_id",
    "window_size",
    "metric_id",
    "k",
    "windows_total",
    "windows_eligible",
    "windows_excluded",
    "effective_count",
    "observed",
    "null_summary",
    "reason_code"
  ],
  "properties": {
    "run_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
    "replicon_id": {"$ref": "dosa_v3_common.schema.json#/$defs/id"},
    "window_size": {"enum": [16, 100, 500, 1000]},
    "metric_id": {"enum": ["positional_r", "positional_rc", "kmer_r", "kmer_rc"]},
    "k": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
    "windows_total": {"type": "integer", "minimum": 0},
    "windows_eligible": {"type": "integer", "minimum": 0},
    "windows_excluded": {"type": "integer", "minimum": 0},
    "effective_count": {"type": "integer", "minimum": 0},
    "observed": {"oneOf": [{"type": "null"}, {"$ref": "dosa_v3_common.schema.json#/$defs/exactFraction"}]},
    "null_summary": {"$ref": "dosa_v3_window_profile.schema.json#/$defs/nullSummary"},
    "reason_code": {"$ref": "dosa_v3_common.schema.json#/$defs/reasonCode"}
  },
  "allOf": [
    {
      "if": {"properties": {"metric_id": {"enum": ["positional_r", "positional_rc"]}}},
      "then": {"properties": {"k": {"type": "null"}}}
    },
    {
      "if": {"properties": {"metric_id": {"const": "kmer_r"}}},
      "then": {"properties": {"k": {"type": "integer", "minimum": 2, "maximum": 8}}}
    },
    {
      "if": {"properties": {"metric_id": {"const": "kmer_rc"}}},
      "then": {"properties": {"k": {"type": "integer", "minimum": 1, "maximum": 8}}}
    }
  ]
}
